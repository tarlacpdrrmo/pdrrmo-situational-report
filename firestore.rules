rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPublicDashboardCollection(name) {
      return name in [
        'actions_data',
        'agri_damages',
        'assistance_data',
        'casualties_data',
        'evacuation_data',
        'flood_emergency_events',
        'flood_event_registry',
        'flooded_areas',
        'infrastructure_data',
        'lifeline_data',
        'preemptive_data',
        'related_incidents',
        'resource_data',
        'weather_conditions'
      ];
    }

    function isSignedInOnlyCollection(name) {
      return name in [
        'complement_data',
        'inventory_data',
        'suspensions_data'
      ];
    }

    function isWritableCollection(name) {
      return isPublicDashboardCollection(name) || isSignedInOnlyCollection(name);
    }

    // Executive Analytics reads these records without requiring sign-in.
    // Firestore reads return whole documents, so every field in these
    // collections is public. Keep personal or restricted fields elsewhere.
    match /{collectionName}/{documentId} {
      allow read: if isPublicDashboardCollection(collectionName)
        || (isSignedInOnlyCollection(collectionName) && request.auth != null);

      // Data Entry and the other staff workspaces already require Firebase
      // Authentication. This first recovery pass grants writes to signed-in
      // accounts only, and only for collections used by this application.
      allow create, update, delete: if isWritableCollection(collectionName)
        && request.auth != null;
    }
  }
}
